---
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className } = Astro.props;
// Size the actual image content, not a border box, at exactly two CSS pixels per LCD pixel.
const width = image.width * 2;
const height = image.height * 2;
---
<img
  class:list={['manual-lcd', className]}
  src={image.src}
  alt={alt}
  width={width}
  height={height}
  style={{ '--lcd-width': `${width}px`, '--lcd-height': `${height}px` }}
/>
